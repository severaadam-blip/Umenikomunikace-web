{
  "name": "umenikomunikace-web",
  "main": "_worker.js",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "vars": { "MAIL_FROM": "Umění komunikace <web@umenikomunikace.com>" },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
